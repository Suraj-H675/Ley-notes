{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ley:schema:agent-memory:session-event:1",
  "title": "Ley immutable agent session event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "projectId",
    "sessionId",
    "requestId",
    "requestFingerprint",
    "sequence",
    "recordedAtUnixMs",
    "redactions",
    "kind",
    "data"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{64}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{32}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_[0-9a-f]{32}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{32}$"
    },
    "requestFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "recordedAtUnixMs": {
      "type": "integer",
      "minimum": 1
    },
    "redactions": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/redaction" }
    },
    "kind": {
      "enum": [
        "session-started",
        "checkpoint-recorded",
        "session-finished"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "session-started" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/sessionStarted" }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "checkpoint-recorded" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ley:schema:agent-memory:session:1#/$defs/checkpoint"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "session-finished" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ley:schema:agent-memory:session:1#/$defs/finish"
          }
        }
      }
    }
  ],
  "$defs": {
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "kind", "lines"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "sessionStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "goal",
        "source",
        "artifactSnapshotId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "source": {
          "$ref": "urn:ley:schema:agent-memory:session:1#/$defs/source"
        },
        "artifactSnapshotId": {
          "$ref": "urn:ley:schema:agent-memory:session:1#/$defs/snapshotId"
        }
      }
    }
  }
}
