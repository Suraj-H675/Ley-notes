{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ley:schema:agent-memory:session:1",
  "title": "Ley derived agent session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "sessionId",
    "name",
    "goal",
    "status",
    "source",
    "artifactSnapshotIdAtStart",
    "startedAtUnixMs",
    "updatedAtUnixMs",
    "eventCount",
    "checkpoints"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "$ref": "#/$defs/projectId" },
    "sessionId": { "$ref": "#/$defs/sessionId" },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "status": { "$ref": "#/$defs/sessionStatus" },
    "source": { "$ref": "#/$defs/source" },
    "artifactSnapshotIdAtStart": { "$ref": "#/$defs/snapshotId" },
    "startedAtUnixMs": { "$ref": "#/$defs/timestamp" },
    "updatedAtUnixMs": { "$ref": "#/$defs/timestamp" },
    "finishedAtUnixMs": { "$ref": "#/$defs/timestamp" },
    "eventCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "checkpoints": {
      "type": "array",
      "maxItems": 9999,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "finish": { "$ref": "#/$defs/finish" }
  },
  "$defs": {
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{32}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_[0-9a-f]{32}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{64}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snp_[0-9a-f]{64}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 1
    },
    "sessionStatus": {
      "enum": ["active", "completed", "paused", "abandoned"]
    },
    "finishedStatus": {
      "enum": ["completed", "paused", "abandoned"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["manual-cli", "host-hook", "mcp", "import"]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "eventId",
        "recordedAtUnixMs",
        "summary",
        "plan",
        "decisions",
        "tasks",
        "problems",
        "touchedArtifacts",
        "commands",
        "verification",
        "unresolved"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ckp_[0-9a-f]{32}$"
        },
        "eventId": { "$ref": "#/$defs/eventId" },
        "recordedAtUnixMs": { "$ref": "#/$defs/timestamp" },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "plan": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/planItem" }
        },
        "decisions": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/decision" }
        },
        "tasks": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/task" }
        },
        "problems": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/problem" }
        },
        "touchedArtifacts": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/artifactCitation" }
        },
        "commands": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/command" }
        },
        "verification": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/verification" }
        },
        "unresolved": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "planItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pln_[0-9a-f]{32}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "status": {
          "enum": ["pending", "in-progress", "completed", "blocked"]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "decision",
        "rationale",
        "alternatives"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dec_[0-9a-f]{32}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "rationale": {
          "type": "string",
          "maxLength": 8000
        },
        "alternatives": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "details"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{32}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "pending",
            "in-progress",
            "completed",
            "blocked",
            "cancelled"
          ]
        },
        "details": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "symptom",
        "expected",
        "attempts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^prb_[0-9a-f]{32}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "symptom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "expected": {
          "type": "string",
          "maxLength": 8000
        },
        "attempts": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/attempt" }
        },
        "resolution": { "$ref": "#/$defs/resolution" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "outcome", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^att_[0-9a-f]{32}$"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "outcome": {
          "enum": ["helped", "no-effect", "worsened", "unknown"]
        },
        "evidence": {
          "type": "string",
          "maxLength": 8000
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rootCause",
        "change",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^res_[0-9a-f]{32}$"
        },
        "rootCause": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "change": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "verification": {
          "type": "string",
          "maxLength": 8000
        }
      }
    },
    "artifactCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPath",
        "artifactSnapshotId",
        "contentHash",
        "startLine",
        "endLine"
      ],
      "properties": {
        "artifactPath": {
          "type": "string",
          "minLength": 1
        },
        "artifactSnapshotId": { "$ref": "#/$defs/snapshotId" },
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "summary"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cmd_[0-9a-f]{32}$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "exitCode": {
          "type": "integer"
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "summary"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ver_[0-9a-f]{32}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "enum": ["passed", "failed", "skipped", "unknown"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "recordedAtUnixMs",
        "status",
        "summary",
        "finalResponse",
        "handoff",
        "unresolved"
      ],
      "properties": {
        "eventId": { "$ref": "#/$defs/eventId" },
        "recordedAtUnixMs": { "$ref": "#/$defs/timestamp" },
        "status": { "$ref": "#/$defs/finishedStatus" },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "finalResponse": {
          "type": "string",
          "maxLength": 32000
        },
        "handoff": {
          "type": "string",
          "maxLength": 16000
        },
        "unresolved": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    }
  }
}
