{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ley:schema:agent-memory:artifact-manifest:1",
  "title": "Ley deterministic project artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "projectName",
    "snapshotId",
    "generatedAtUnixMs",
    "captureMode",
    "capturePolicy",
    "captureFingerprint",
    "files",
    "skipped"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{32}$"
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snp_[0-9a-f]{64}$"
    },
    "generatedAtUnixMs": {
      "type": "integer",
      "minimum": 0
    },
    "captureMode": {
      "enum": ["minimal", "structured", "full-evidence"]
    },
    "capturePolicy": {
      "$ref": "#/$defs/capturePolicy"
    },
    "captureFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "skipped": {
      "type": "array",
      "items": { "$ref": "#/$defs/skippedArtifact" }
    }
  },
  "$defs": {
    "capturePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "approvedRoots",
        "respectGitignore",
        "maxFileBytes",
        "maxTotalBytes",
        "storeRawTranscripts"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "mode": {
          "enum": ["minimal", "structured", "full-evidence"]
        },
        "approvedRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "respectGitignore": { "type": "boolean" },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxTotalBytes": {
          "type": "integer",
          "minimum": 1
        },
        "storeRawTranscripts": { "type": "boolean" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "sourceBytes",
        "storedBytes",
        "lineCount",
        "contentHash",
        "redactions"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "source",
            "documentation",
            "manifest",
            "configuration",
            "text"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "sourceBytes": {
          "type": "integer",
          "minimum": 0
        },
        "storedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "lineCount": {
          "type": "integer",
          "minimum": 0
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contentBlob": {
          "type": "string",
          "pattern": "^content/[0-9a-f]{64}\\.txt$"
        },
        "redactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/redaction" }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lines"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      }
    },
    "skippedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": [
            "binary",
            "non-utf8",
            "oversized",
            "total-limit",
            "symlink"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
