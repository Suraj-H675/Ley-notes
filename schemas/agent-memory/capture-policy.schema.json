{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ley:schema:agent-memory:capture-policy:1",
  "title": "Ley project capture policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "approvedRoots",
    "respectGitignore",
    "maxFileBytes",
    "maxTotalBytes",
    "storeRawTranscripts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": {
      "enum": ["minimal", "structured", "full-evidence"]
    },
    "approvedRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "A path relative to the initialized project root. Absolute and parent-traversal paths are invalid."
      }
    },
    "respectGitignore": { "type": "boolean" },
    "maxFileBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maxTotalBytes": {
      "type": "integer",
      "minimum": 1
    },
    "storeRawTranscripts": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "storeRawTranscripts": { "const": true } },
        "required": ["storeRawTranscripts"]
      },
      "then": {
        "properties": { "mode": { "const": "full-evidence" } }
      }
    }
  ]
}
