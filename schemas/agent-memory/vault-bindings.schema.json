{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ley:schema:agent-memory:vault-bindings:1",
  "title": "Ley private project-to-vault bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bindings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^prj_[0-9a-f]{32}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
