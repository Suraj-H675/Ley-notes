{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ley:schema:agent-memory:project-graph:1",
  "title": "Ley deterministic project graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "projectName",
    "artifactSnapshotId",
    "graphSnapshotId",
    "generatedAtUnixMs",
    "nodes",
    "edges",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{32}$"
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "artifactSnapshotId": {
      "type": "string",
      "pattern": "^snp_[0-9a-f]{64}$"
    },
    "graphSnapshotId": {
      "type": "string",
      "pattern": "^grf_[0-9a-f]{64}$"
    },
    "generatedAtUnixMs": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "git": {
      "$ref": "#/$defs/gitState"
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPath",
        "startLine",
        "startColumn",
        "endLine",
        "endColumn",
        "contentHash",
        "artifactSnapshotId"
      ],
      "properties": {
        "artifactPath": {
          "type": "string",
          "minLength": 1
        },
        "startLine": {
          "type": "integer",
          "minimum": 0
        },
        "startColumn": {
          "type": "integer",
          "minimum": 0
        },
        "endLine": {
          "type": "integer",
          "minimum": 0
        },
        "endColumn": {
          "type": "integer",
          "minimum": 0
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifactSnapshotId": {
          "type": "string",
          "pattern": "^snp_[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "enum": [
        "deterministic",
        "user-authored",
        "agent-authored",
        "inferred"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "provenance",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(prj|fil|sym|dep|ext)_[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "project",
            "file",
            "symbol",
            "dependency",
            "external-symbol",
            "external-module"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "symbolKind": {
          "type": "string",
          "minLength": 1
        },
        "packageManager": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "$ref": "#/$defs/citation"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "provenance",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^edg_[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "contains",
            "defines",
            "imports",
            "calls",
            "inherits",
            "implements",
            "references",
            "depends-on"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^(prj|fil|sym|dep|ext)_[0-9a-f]{64}$"
        },
        "target": {
          "type": "string",
          "pattern": "^(prj|fil|sym|dep|ext)_[0-9a-f]{64}$"
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "citation": {
          "$ref": "#/$defs/citation"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactPath", "kind", "message"],
      "properties": {
        "artifactPath": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "gitChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path"],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "originalPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gitState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ahead", "behind", "changes"],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "upstream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "ahead": {
          "type": "integer",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/gitChange" }
        }
      }
    }
  }
}
