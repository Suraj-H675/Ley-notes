{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ley:schema:agent-memory:session-event:2",
  "title": "Ley immutable agent session event with turn evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "projectId",
    "sessionId",
    "requestId",
    "requestFingerprint",
    "sequence",
    "recordedAtUnixMs",
    "redactions",
    "kind",
    "data"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "eventId": { "type": "string", "pattern": "^evt_[0-9a-f]{64}$" },
    "projectId": { "type": "string", "pattern": "^prj_[0-9a-f]{32}$" },
    "sessionId": { "type": "string", "pattern": "^ses_[0-9a-f]{32}$" },
    "requestId": { "type": "string", "pattern": "^req_[0-9a-f]{32}$" },
    "requestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "recordedAtUnixMs": { "type": "integer", "minimum": 1 },
    "redactions": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "urn:ley:schema:agent-memory:session-event:1#/$defs/redaction" }
    },
    "kind": {
      "enum": [
        "user-prompt-observed",
        "assistant-response-observed"
      ]
    },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "user-prompt-observed" } }, "required": ["kind"] },
      "then": { "properties": { "data": { "$ref": "#/$defs/promptEvidence" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "assistant-response-observed" } }, "required": ["kind"] },
      "then": { "properties": { "data": { "$ref": "#/$defs/responseEvidence" } } }
    }
  ],
  "$defs": {
    "promptEvidence": {
      "allOf": [
        { "$ref": "urn:ley:schema:agent-memory:session:2#/$defs/turnEvidence" },
        { "properties": { "text": { "maxLength": 4000 } } }
      ]
    },
    "responseEvidence": { "$ref": "urn:ley:schema:agent-memory:session:2#/$defs/turnEvidence" }
  }
}
