{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ley:schema:agent-memory:learning-event:1",
  "title": "Ley immutable project learning event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "projectId",
    "learningId",
    "requestId",
    "requestFingerprint",
    "sequence",
    "recordedAtUnixMs",
    "redactions",
    "kind",
    "data"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "$ref": "#/$defs/eventId" },
    "projectId": { "$ref": "#/$defs/projectId" },
    "learningId": { "$ref": "#/$defs/learningId" },
    "requestId": { "$ref": "#/$defs/requestId" },
    "requestFingerprint": { "$ref": "#/$defs/hash" },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "recordedAtUnixMs": {
      "type": "integer",
      "minimum": 1
    },
    "redactions": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/redaction" }
    },
    "kind": {
      "enum": ["proposed", "corrected", "reviewed"]
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "proposed" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/proposed" }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "corrected" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/corrected" }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "reviewed" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/reviewed" }
        }
      }
    }
  ],
  "$defs": {
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{32}$"
    },
    "learningId": {
      "type": "string",
      "pattern": "^lrn_[0-9a-f]{32}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^lev_[0-9a-f]{64}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{32}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor": {
      "enum": ["user", "agent"]
    },
    "provenance": {
      "enum": ["user-authored", "agent-authored", "inferred"]
    },
    "learningKind": {
      "enum": ["procedure", "constraint", "pitfall", "convention", "fact"]
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "guidance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "note": {
      "type": "string",
      "maxLength": 4000
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "kind", "lines"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "artifactCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPath",
        "artifactSnapshotId",
        "contentHash",
        "startLine",
        "endLine"
      ],
      "properties": {
        "artifactPath": {
          "type": "string",
          "minLength": 1
        },
        "artifactSnapshotId": {
          "type": "string",
          "pattern": "^snp_[0-9a-f]{64}$"
        },
        "contentHash": { "$ref": "#/$defs/hash" },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "recordId",
        "recordType",
        "sessionStatus",
        "sessionUpdatedAtUnixMs",
        "note",
        "artifacts"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^ses_[0-9a-f]{32}$"
        },
        "recordId": {
          "type": "string",
          "pattern": "^(ses_[0-9a-f]{32}|evt_[0-9a-f]{64}|(ckp|pln|dec|tsk|prb|att|res|cmd|ver)_[0-9a-f]{32})$"
        },
        "recordType": {
          "enum": [
            "session",
            "session-finish",
            "checkpoint",
            "plan-item",
            "decision",
            "task",
            "command",
            "verification",
            "problem",
            "attempt",
            "resolution"
          ]
        },
        "sessionStatus": {
          "enum": ["active", "completed", "paused", "abandoned"]
        },
        "sessionUpdatedAtUnixMs": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "artifacts": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/artifactCitation" }
        }
      }
    },
    "evidenceList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "proposed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "kind",
        "title",
        "guidance",
        "confidencePercent",
        "provenance",
        "evidence"
      ],
      "properties": {
        "actor": { "$ref": "#/$defs/actor" },
        "kind": { "$ref": "#/$defs/learningKind" },
        "title": { "$ref": "#/$defs/title" },
        "guidance": { "$ref": "#/$defs/guidance" },
        "confidencePercent": { "$ref": "#/$defs/confidence" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },
    "corrected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "title",
        "guidance",
        "confidencePercent",
        "evidence",
        "note"
      ],
      "properties": {
        "actor": { "$ref": "#/$defs/actor" },
        "title": { "$ref": "#/$defs/title" },
        "guidance": { "$ref": "#/$defs/guidance" },
        "confidencePercent": { "$ref": "#/$defs/confidence" },
        "evidence": { "$ref": "#/$defs/evidenceList" },
        "note": { "$ref": "#/$defs/note" }
      }
    },
    "reviewed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "action",
        "note"
      ],
      "properties": {
        "actor": { "$ref": "#/$defs/actor" },
        "action": {
          "enum": ["confirm", "contest", "reject", "mark-stale", "supersede"]
        },
        "note": { "$ref": "#/$defs/note" },
        "replacementLearningId": { "$ref": "#/$defs/learningId" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "supersede" } },
            "required": ["action"]
          },
          "then": {
            "required": ["replacementLearningId"]
          },
          "else": {
            "not": {
              "required": ["replacementLearningId"]
            }
          }
        }
      ]
    }
  }
}
