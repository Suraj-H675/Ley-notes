{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ley:schema:agent-memory:learning:1",
  "title": "Ley derived project learning",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "learningId",
    "kind",
    "title",
    "guidance",
    "state",
    "trustState",
    "provenance",
    "confidencePercent",
    "freshness",
    "corroboratingSessions",
    "createdAtUnixMs",
    "updatedAtUnixMs",
    "validFromUnixMs",
    "evidence",
    "history",
    "eventCount"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{32}$"
    },
    "learningId": {
      "type": "string",
      "pattern": "^lrn_[0-9a-f]{32}$"
    },
    "kind": {
      "enum": ["procedure", "constraint", "pitfall", "convention", "fact"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "guidance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "state": {
      "enum": [
        "tentative",
        "verified",
        "contested",
        "superseded",
        "rejected",
        "stale"
      ]
    },
    "trustState": {
      "enum": [
        "review-required",
        "trusted",
        "contested",
        "superseded",
        "rejected",
        "stale"
      ]
    },
    "provenance": {
      "enum": ["user-authored", "agent-authored", "inferred"]
    },
    "confidencePercent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "freshness": {
      "enum": ["current", "source-changed", "uncited"]
    },
    "corroboratingSessions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "createdAtUnixMs": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAtUnixMs": {
      "type": "integer",
      "minimum": 1
    },
    "validFromUnixMs": {
      "type": "integer",
      "minimum": 1
    },
    "validUntilUnixMs": {
      "type": "integer",
      "minimum": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "urn:ley:schema:agent-memory:learning-event:1#/$defs/evidence"
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "recordedAtUnixMs",
          "actor",
          "action",
          "note"
        ],
        "properties": {
          "eventId": {
            "$ref": "urn:ley:schema:agent-memory:learning-event:1#/$defs/eventId"
          },
          "recordedAtUnixMs": {
            "type": "integer",
            "minimum": 1
          },
          "actor": {
            "$ref": "urn:ley:schema:agent-memory:learning-event:1#/$defs/actor"
          },
          "action": {
            "enum": [
              "proposed",
              "corrected",
              "confirm",
              "contest",
              "reject",
              "mark-stale",
              "supersede"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    },
    "supersededBy": {
      "type": "string",
      "pattern": "^lrn_[0-9a-f]{32}$"
    },
    "eventCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}
