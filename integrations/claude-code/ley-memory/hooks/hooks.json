{
  "description": "Load and capture bounded local Ley project memory.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ley",
            "args": [
              "hook",
              "--host",
              "claude",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 20,
            "statusMessage": "Loading Ley project memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ley",
            "args": [
              "hook",
              "--host",
              "claude",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 20,
            "statusMessage": "Capturing Ley turn"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ley",
            "args": [
              "hook",
              "--host",
              "claude",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 20,
            "statusMessage": "Saving bounded Ley Bash evidence"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ley",
            "args": [
              "hook",
              "--host",
              "claude",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 20,
            "statusMessage": "Saving bounded Ley Bash failure evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ley",
            "args": [
              "hook",
              "--host",
              "claude",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 20,
            "statusMessage": "Saving bounded Ley response"
          }
        ]
      }
    ]
  }
}
