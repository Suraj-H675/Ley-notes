{
  "description": "Load and capture bounded local Ley project memory.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "ley hook --host codex",
            "timeout": 20,
            "statusMessage": "Loading Ley project memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ley hook --host codex",
            "additionalContextLimit": 5000,
            "timeout": 20,
            "statusMessage": "Capturing Ley turn"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ley hook --host codex",
            "timeout": 20,
            "statusMessage": "Saving bounded Ley Bash evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ley hook --host codex",
            "timeout": 20,
            "statusMessage": "Saving bounded Ley response"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ley hook --host codex",
            "timeout": 20,
            "statusMessage": "Closing Ley project session"
          }
        ]
      }
    ]
  }
}
