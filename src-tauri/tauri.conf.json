{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ley",
  "version": "0.1.0",
  "identifier": "app.leynotes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop-runtime",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop-ui",
    "beforeBundleCommand": "npm run prepare:desktop-resources",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Ley",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "backgroundColor": "#17191d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:* http://localhost:*"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1NDdBQTY1QzFCMjYyRTQKUldUa1lyTEJaYXBIbGVBU3FQb3RhQm1HN0RIemkzZVFKR29XdEg4NEdqMFNDcEhWRFgzNDlGMFAK",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "generated/ley-helper",
      "generated/THIRD_PARTY_NOTICES.txt",
      "generated/LICENSE-MIT",
      "generated/LICENSE-APACHE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local continuity for coding agents",
    "longDescription": "Ley keeps durable project memory small, cited, revision-aware, and under your control so coding agents can continue useful work without trusting stale summaries blindly."
  }
}
