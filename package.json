{
  "name": "ley",
  "private": true,
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:website": "vite",
    "dev:desktop-ui": "vite --config vite.desktop.config.ts",
    "dev:desktop-runtime": "npm run prepare:desktop-helper && npm run dev:desktop-ui",
    "prepare:desktop-helper": "node scripts/prepare-desktop-helper.mjs",
    "prepare:license-resources": "node scripts/prepare-license-resources.mjs",
    "prepare:third-party-notices": "node scripts/write-third-party-notices.mjs",
    "prepare:desktop-resources": "npm run prepare:desktop-helper && npm run prepare:license-resources && npm run prepare:third-party-notices",
    "prepare:release-config": "node scripts/write-release-config.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "build": "npm run build:website",
    "build:website": "tsc && vite build",
    "build:desktop-ui": "tsc && vite build --config vite.desktop.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src desktop --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"desktop/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.19",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-updater": "2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.16",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
